+async function notifyAutomationDashboard(
+        req: Request,
+        releaseMbid: string,
+        deezer: string | null,
+        gtin: string | null,
+): Promise<void> {
+        try {
+                const response = await fetch(automationDashboardUrl, {
+                        method: 'POST',
+                        headers: {
+                                'Content-Type': 'application/json',
