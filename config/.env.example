# ============================================================
# MusicBrainz Automation Configuration
# ============================================================

# URL that a user's web browser uses to reach Harmony.
# Example:
# HARMONY_BROWSER_URL=http://192.168.1.100:8001
HARMONY_BROWSER_URL=http://YOUR_DOCKER_LXC_IP:8001

# Internal URL that the browser controller uses to reach the dashboard.
DASHBOARD_URL=http://dashboard:8080

# URL that the Chromium container uses to reach the dashboard.
# Example:
# DASHBOARD_BROWSER_URL=http://192.168.1.100:8088
DASHBOARD_BROWSER_URL=http://YOUR_DOCKER_LXC_IP:8088

# MusicBrainz User-Agent.
# MusicBrainz asks automated clients to identify themselves.
# Replace the example contact information with your own.
MB_USER_AGENT=MBAutomationScript/1.2 (https://github.com/YOUR_USERNAME/musicbrainz-automation)

# Harmony Tidal API credentials.
# Obtain these from your Harmony configuration.
HARMONY_TIDAL_CLIENT_ID=
HARMONY_TIDAL_CLIENT_SECRET=
